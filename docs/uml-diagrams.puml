@startuml Sequence_ExportReport
!theme plain
title Sequence Diagram - Export Report to Excel/PDF

actor "Super Admin" as SA
participant "Export Panel" as EP
participant "Export API\n/api/tickets/export" as API
participant "ExcelJS" as Excel
participant "PDFKit" as PDF
database "MySQL\nDatabase" as DB

SA -> EP: Set filters\n(category, date range, status)
SA -> EP: Click Export Excel

EP -> API: GET /api/tickets/export?\nformat=excel&category=IT&startDate=...

API -> API: Validate JWT (super_admin only)

API -> DB: SELECT * FROM tickets\nWHERE category = ?\nAND created_at BETWEEN ? AND ?
DB --> API: Filtered tickets[]

alt Format = Excel
    API -> Excel: Create Workbook
    Excel -> Excel: Create Worksheet
    Excel -> Excel: Add styled headers

    loop For each ticket
        Excel -> Excel: Add row with data
        Excel -> Excel: Apply status color
    end

    Excel -> Excel: Add summary row
    Excel -> Excel: Generate buffer
    Excel --> API: XLSX buffer

    API --> EP: application/xlsx\nContent-Disposition: attachment

else Format = PDF
    API -> PDF: Create Document
    PDF -> PDF: Set A4 Landscape
    PDF -> PDF: Add header & title
    PDF -> PDF: Add filter info

    loop For each ticket
        PDF -> PDF: Add table row
        PDF -> PDF: Check page break
    end

    PDF -> PDF: Add page numbers
    PDF -> PDF: Add summary
    PDF -> PDF: Generate buffer
    PDF --> API: PDF buffer

    API --> EP: application/pdf\nContent-Disposition: attachment
end

EP --> SA: Download file

@enduml


' ============================================================
' SEQUENCE DIAGRAM - NOTIFICATION POLLING
' ============================================================

@startuml Sequence_NotificationPolling
!theme plain
title Sequence Diagram - Notification Polling

actor User
participant "Dashboard" as D
participant "Notification API" as API
database "MySQL\nDatabase" as DB

== Initial Load ==
User -> D: Open Dashboard

D -> API: GET /api/user/notifications
API -> API: Validate JWT
API -> DB: SELECT * FROM user_notifications\nWHERE id_user = ?\nORDER BY created_at DESC
DB --> API: Notifications[]
API --> D: {notifications, unreadCount}
D -> D: Update notification badge
D --> User: Show unread count

== Polling Loop (every 30s) ==
loop Every 30 seconds
    D -> API: GET /api/user/notifications
    API -> DB: Get latest notifications
    DB --> API: Notifications[]
    API --> D: {notifications, unreadCount}
    D -> D: Update badge if changed
end

== Mark as Read ==
User -> D: Click notification
D -> API: PATCH /api/user/notifications\n{notification_id, is_read: true}
API -> DB: UPDATE user_notifications\nSET is_read = true
DB --> API: Success
API --> D: Updated notification
D -> D: Decrease unread count
D --> User: Navigate to ticket

== Mark All Read ==
User -> D: Click "Mark All Read"
D -> API: POST /api/user/notifications/mark-all-read
API -> DB: UPDATE user_notifications\nSET is_read = true\nWHERE id_user = ?
DB --> API: Success
API --> D: {success: true}
D -> D: Set unread count = 0
D --> User: All notifications marked read

@enduml


