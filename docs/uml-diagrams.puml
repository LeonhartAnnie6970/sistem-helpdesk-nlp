' ============================================================
' COMMUNICATION DIAGRAM
' ============================================================

@startuml Communication_Diagram
!theme plain
title Communication Diagram - Ticket Creation Flow

actor User as user

participant "Ticket Form" as form
participant "Tickets API" as ticketsApi
participant "NLP API" as nlpApi
participant "Flask Service" as flask
participant "Routing Service" as routing
participant "Notification Service" as notifService
database "MySQL" as db

user -> form : 1: fillForm()
form -> ticketsApi : 2: POST /api/tickets
ticketsApi -> nlpApi : 3: classify(text)
nlpApi -> flask : 4: POST /classify
flask --> nlpApi : 5: {category, confidence}
nlpApi --> ticketsApi : 6: NLPResult
ticketsApi -> routing : 7: getTargetDivisions(category)
routing -> db : 8: SELECT category_mapping
db --> routing : 9: mappings
routing --> ticketsApi : 10: target_divisions[]
ticketsApi -> db : 11: INSERT ticket
db --> ticketsApi : 12: ticket_id
ticketsApi -> notifService : 13: createNotifications(ticket)
notifService -> db : 14: INSERT notifications
notifService --> ticketsApi : 15: done
ticketsApi --> form : 16: {ticket, routing_info}
form --> user : 17: showSuccess()

@enduml
