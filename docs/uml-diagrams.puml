users ||--o{ tickets : "creates"
users ||--o{ notifications : "receives"
users ||--o{ user_notifications : "receives"
users ||--o{ super_admin_notifications : "receives"
users ||--o{ ticket_comments : "writes"
users ||--o| tickets : "overrides (overridden_by)"

tickets ||--o{ notifications : "generates"
tickets ||--o{ user_notifications : "generates"
tickets ||--o{ super_admin_notifications : "generates"
