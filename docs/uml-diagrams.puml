' ============================================================
' STATE DIAGRAM - TICKET
' ============================================================

@startuml State_Ticket
!theme plain
title State Diagram - Ticket Lifecycle

[*] --> New : Ticket created

state New {
    New : Entry / Classify with NLP
    New : Entry / Route to divisions
    New : Entry / Create notifications
}

New --> InProgress : Admin starts working
New --> Closed : Creator closes (no action needed)

state InProgress {
    InProgress : Do / Admin investigates
    InProgress : Do / Add notes
    InProgress : Do / Upload images
}

InProgress --> Resolved : Admin resolves issue
InProgress --> New : Admin returns to queue
InProgress --> Closed : Creator closes

state Resolved {
    Resolved : Entry / Notify creator
    Resolved : Exit / Wait for confirmation
}

Resolved --> InProgress : Creator reopens
Resolved --> Closed : Creator confirms

state Closed {
    Closed : Entry / Final notification
    Closed : Entry / Mark complete
}

Closed --> [*]

note right of New
  Only the following transitions are allowed:
  - User creates: New
  - Admin updates: New → InProgress → Resolved
  - Creator closes: Any → Closed
end note

note right of Closed
  Only ticket creator
  can close the ticket
end note

@enduml


' ============================================================
' STATE DIAGRAM - NOTIFICATION
' ============================================================

@startuml State_Notification
!theme plain
title State Diagram - Notification Lifecycle

[*] --> Created : Trigger event occurs

state Created {
    Created : Entry / Set is_read = false
    Created : Entry / Store in database
}

Created --> Unread : Stored in database

state Unread {
    Unread : Entry / Increment badge count
    Unread : Do / Appear in notification panel
}

Unread --> Read : User clicks notification
Unread --> Read : User marks as read
Unread --> Read : User marks all as read

state Read {
    Read : Entry / Set is_read = true
    Read : Entry / Decrement badge count
}

Read --> [*] : Notification consumed

note right of Created
  Triggers:
  - New ticket created
  - Status updated
  - Admin notes added
  - Admin image uploaded
  - Comment added
end note

@enduml


' ============================================================
' STATE DIAGRAM - USER
' ============================================================

@startuml State_User
!theme plain
title State Diagram - User Account Lifecycle

[*] --> Registered : User registers

state Registered {
    Registered : Entry / Hash password
    Registered : Entry / Set role = user
    Registered : Entry / Set is_active = true
}

Registered --> Active : Registration complete

state Active {
    Active : Do / Can login
    Active : Do / Can create tickets
    Active : Do / Can receive notifications
}

Active --> LoggedIn : User logs in

state LoggedIn {
    LoggedIn : Entry / Generate JWT
    LoggedIn : Entry / Update last_login
    LoggedIn : Do / Access dashboard
}

LoggedIn --> Active : User logs out
LoggedIn --> Active : Token expires

Active --> Inactive : Super admin deactivates

state Inactive {
    Inactive : Entry / Set is_active = false
    Inactive : Do / Cannot login
    Inactive : Do / Account preserved
}

Inactive --> Active : Super admin reactivates

note right of Active
  Role can be:
  - user
  - admin (promoted by super_admin)
  - super_admin
end note

@enduml


