' SEQUENCE DIAGRAM - USER MANAGEMENT
' ============================================================

@startuml Sequence_UserManagement
!theme plain
title Sequence Diagram - User Management (Super Admin)

actor "Super Admin" as SA
participant "User Management\nPanel" as UP
participant "Users API\n/api/super-admin/users" as API
database "MySQL\nDatabase" as DB

== List Users ==
SA -> UP: Open User Management
UP -> API: GET /api/super-admin/users
API -> API: Validate JWT (super_admin)
API -> DB: SELECT * FROM users\nORDER BY created_at DESC
DB --> API: Users[]
API --> UP: {users: [...]}
UP --> SA: Display user list

== Create User ==
SA -> UP: Click "Add User"
SA -> UP: Fill form (name, email, password, role, division)
UP -> API: POST /api/super-admin/users\n{name, email, password, role, division}

API -> DB: SELECT * FROM users WHERE email = ?
DB --> API: Existing user (or null)

alt Email already exists
    API --> UP: 400 Bad Request\n{error: "Email sudah terdaftar"}
    UP --> SA: Display error
else Email available
    API -> API: Hash password (bcrypt)
    API -> DB: INSERT INTO users\n(name, email, password, role, division)
    DB --> API: New user ID
    API --> UP: 201 Created\n{user: {...}}
    UP --> SA: Display success, refresh list
end

== Update User ==
SA -> UP: Select user, edit details
UP -> API: PATCH /api/super-admin/users\n{id, name, email, role, division}
API -> DB: UPDATE users SET ... WHERE id = ?
DB --> API: Success
API --> UP: 200 OK {user: updated}
UP --> SA: Display success

== Deactivate User ==
SA -> UP: Click deactivate on user
SA -> UP: Confirm deactivation
UP -> API: DELETE /api/super-admin/users\n{id}
API -> DB: UPDATE users\nSET is_active = false\nWHERE id = ?
DB --> API: Success
API --> UP: 200 OK {message: "User dinonaktifkan"}
UP --> SA: Refresh list, show deactivated

@enduml


' ============================================================
' SEQUENCE DIAGRAM - DELETE TICKET
' ============================================================

@startuml Sequence_DeleteTicket
!theme plain
title Sequence Diagram - Delete Ticket (Super Admin)

actor "Super Admin" as SA
participant "Tickets Panel" as TP
participant "Tickets API\n/api/tickets/[id]" as API
database "MySQL\nDatabase" as DB

SA -> TP: Click delete button on ticket
TP -> TP: Open confirmation dialog
SA -> TP: Confirm deletion

TP -> API: DELETE /api/tickets/{id}

API -> API: Validate JWT token
API -> API: Check role

alt Role is NOT super_admin
    API --> TP: 403 Forbidden\n{error: "Hanya Super Admin"}
    TP --> SA: Display error message
else Role is super_admin
    API -> DB: SELECT * FROM tickets WHERE id = ?
    DB --> API: Ticket record

    alt Ticket not found
        API --> TP: 404 Not Found\n{error: "Tiket tidak ditemukan"}
        TP --> SA: Display error
    else Ticket exists
        API -> DB: BEGIN TRANSACTION

        API -> DB: DELETE FROM ticket_comments\nWHERE ticket_id = ?
        DB --> API: Deleted comments

        API -> DB: DELETE FROM user_notifications\nWHERE id_ticket = ?
        DB --> API: Deleted user notifications

        API -> DB: DELETE FROM notifications\nWHERE id_ticket = ?
        DB --> API: Deleted admin notifications

        API -> DB: DELETE FROM super_admin_notifications\nWHERE id_ticket = ?
        DB --> API: Deleted super admin notifications

        API -> DB: DELETE FROM tickets\nWHERE id = ?
        DB --> API: Ticket deleted

        API -> DB: COMMIT

        API --> TP: 200 OK\n{message: "Tiket berhasil dihapus"}
        TP -> TP: Close dialog
        TP -> TP: Refresh ticket list
        TP --> SA: Display success message
    end
end

@enduml


' ============================================================
' SEQUENCE DIAGRAM - COMMENT ON TICKET
' ============================================================

@startuml Sequence_AddComment
!theme plain
title Sequence Diagram - Add Comment to Ticket

actor User
participant "Ticket Detail\nModal" as TD
participant "Comments API\n/api/tickets/[id]/comments" as API
database "MySQL\nDatabase" as DB

User -> TD: Type comment
User -> TD: Attach file (optional)
User -> TD: Click Send

TD -> API: POST /api/tickets/{id}/comments\n{comment, attachment}

API -> API: Validate JWT token
API -> DB: SELECT * FROM tickets WHERE id = ?
DB --> API: Ticket record

API -> API: Check access rights
note right
    User can comment if:
    - Created the ticket
    - Admin of user's division
    - Admin of target division
    - Super admin
end note

alt Has access
    API -> DB: INSERT INTO ticket_comments\n(ticket_id, user_id, comment,\ncomment_type, attachment_path)
    DB --> API: Comment created

    alt Commenter is admin
        API -> DB: INSERT INTO user_notifications\n(for ticket creator)
        DB --> API: Notification created
    else Commenter is user
        API -> DB: Get relevant admins
        API -> DB: INSERT INTO notifications\n(for each admin)
        DB --> API: Notifications created
    end

    API --> TD: 201 Created\n{comment: {...}}
    TD -> TD: Refresh comments list
    TD --> User: Display new comment

else No access
    API --> TD: 403 Forbidden
    TD --> User: Display error
end

@enduml


