' ============================================================
' ACTIVITY DIAGRAM - LOGIN
' ============================================================

@startuml Activity_Login
!theme plain
title Activity Diagram - Login Process

start

:User opens login page;

:User enters email and password;

:Click login button;

:Send POST /api/auth/login;

if (Email exists in database?) then (yes)
    if (Password valid (bcrypt compare)?) then (yes)
        if (User is_active = true?) then (yes)
            :Generate JWT Token;
            :Store token in localStorage;
            :Update last_login timestamp;

            if (User role?) then (super_admin)
                :Redirect to /super-admin/dashboard;
            else if (admin) then (admin)
                :Redirect to /admin/dashboard;
            else (user)
                :Redirect to /dashboard;
            endif

            :Display success notification;
            stop
        else (no)
            :Display "Account deactivated" error;
            stop
        endif
    else (no)
        :Display "Invalid password" error;
        stop
    endif
else (no)
    :Display "Email not found" error;
    stop
endif

@enduml


' ============================================================
' ACTIVITY DIAGRAM - REGISTER
' ============================================================

@startuml Activity_Register
!theme plain
title Activity Diagram - User Registration

start

:User opens registration page;

:User fills registration form;
note right
  - Name
  - Email
  - Password
  - Confirm Password
  - Division
end note

:Click register button;

if (All fields filled?) then (yes)
    if (Password matches confirmation?) then (yes)
        if (Password >= 6 characters?) then (yes)
            :Send POST /api/auth/register;

            if (Email already exists?) then (no)
                :Hash password with bcrypt;
                :Create user record in database;
                :Set role = 'user';
                :Set is_active = true;
                :Display success message;
                :Redirect to login page;
                stop
            else (yes)
                :Display "Email already registered" error;
                stop
            endif
        else (no)
            :Display "Password too short" error;
            stop
        endif
    else (no)
        :Display "Passwords don't match" error;
        stop
    endif
else (no)
    :Display "Fill all fields" error;
    stop
endif

@enduml


' ============================================================
' ACTIVITY DIAGRAM - CREATE TICKET
' ============================================================

@startuml Activity_CreateTicket
!theme plain
title Activity Diagram - Create Ticket with NLP Classification

|User|
start
:Open ticket creation form;
:Fill ticket details;
note right
  - Title
  - Description
  - Category (optional)
  - Image (optional)
end note

:Click submit button;

|System|
:Validate input data;

if (Valid input?) then (yes)
    :Get user info from JWT token;
    :Get user division;

    |NLP API|
    :Send text to NLP API;
    :Process with TF-IDF vectorizer;
    :Classify with trained model;
    :Extract keywords;
    :Calculate confidence score;
    :Return classification result;

    |System|
    :Receive NLP result;
    note right
      - nlp_category
      - nlp_confidence
      - nlp_keywords
    end note

    :Map category to target divisions;
    :Get category_division_mapping;

    fork
        :Create ticket record;
        note right
          - title, description
          - category
          - user_division
          - target_divisions (JSON)
          - nlp_category
          - nlp_confidence
          - nlp_keywords
          - status = 'new'
        end note
    fork again
        :Upload image if provided;
        :Store image URL;
    end fork

    :Get admins for notification;
    note right
      - Admins from user division
      - Admins from target divisions
      - All super admins
    end note

    fork
        :Create admin notifications;
    fork again
        :Create super admin notifications;
    fork again
        :Create user notifications for target division users;
    end fork

    |User|
    :Display success message;
    :Show ticket ID and routing info;
    :Refresh ticket list;

else (no)
    |User|
    :Display validation error;
endif

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - UPDATE TICKET STATUS
' ============================================================

@startuml Activity_UpdateTicketStatus
!theme plain
title Activity Diagram - Update Ticket Status (Admin)

|Admin|
start
:Select ticket from list;
:View ticket detail;
:Select new status;
note right
  Available statuses:
  - new
  - in_progress
  - resolved
  - closed (only by creator)
end note

:Click update button;

|System|
:Validate JWT token;
:Check admin authorization;

if (Is admin or super_admin?) then (yes)
    if (Status = 'closed'?) then (yes)
        if (Admin is ticket creator?) then (yes)
            :Update ticket status;
        else (no)
            :Return error: Only creator can close;
            |Admin|
            :Display error message;
            stop
        endif
    else (no)
        :Update ticket status;
    endif

    :Record old_status and new_status;
    :Update updated_at timestamp;

    fork
        :Create ticket comment (status_change);
    fork again
        :Create user notification;
        note right
          type: status_update
          message: Status changed
        end note
    end fork

    |Admin|
    :Display success message;
    :Refresh ticket detail;

else (no)
    |Admin|
    :Display "Unauthorized" error;
endif

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - OVERRIDE NLP
' ============================================================

@startuml Activity_OverrideNLP
!theme plain
title Activity Diagram - Override NLP Classification

|Admin/Super Admin|
start
:View ticket with NLP classification;
:Click "Override NLP" button;
:Select new target division;
:Enter override reason;
:Confirm override;

|System|
:Validate JWT token;
:Check admin/super_admin role;

if (Authorized?) then (yes)
    :Store original NLP values;
    note right
      - original_nlp_division
      - is_nlp_overridden = true
      - override_reason
      - overridden_by (admin_id)
      - overridden_at (timestamp)
    end note

    :Update target_divisions with new division;
    :Update nlp_category if needed;

    fork
        :Create notifications for new target division admins;
    fork again
        :Log override action;
    end fork

    |Admin/Super Admin|
    :Display success message;
    :Show updated routing;

else (no)
    |Admin/Super Admin|
    :Display "Unauthorized" error;
endif

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - DELETE TICKET (Super Admin)
' ============================================================

@startuml Activity_DeleteTicket
!theme plain
title Activity Diagram - Delete Ticket (Super Admin Only)

|Super Admin|
start
:View all tickets list;
:Select ticket to delete;
:Click delete button;
:Confirm deletion in dialog;

|System|
:Validate JWT token;
:Check role = super_admin;

if (Is super_admin?) then (yes)
    :Get ticket ID;

    if (Ticket exists?) then (yes)

        :Begin database transaction;

        fork
            :Delete from ticket_comments;
        fork again
            :Delete from user_notifications;
        fork again
            :Delete from admin_notifications (notifications);
        fork again
            :Delete from super_admin_notifications;
        end fork

        :Delete from tickets;
        :Commit transaction;

        |Super Admin|
        :Display success message;
        :Refresh ticket list;

    else (no)
        |Super Admin|
        :Display "Ticket not found" error;
    endif

else (no)
    |Super Admin|
    :Display "Only Super Admin can delete" error;
endif

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - EXPORT REPORT
' ============================================================

@startuml Activity_ExportReport
!theme plain
title Activity Diagram - Export Report (Excel/PDF)

|Super Admin|
start
:Open export panel;
:Set filter criteria;
note right
  Filters:
  - Format (Excel/PDF)
  - Category
  - Division
  - Status
  - Start Date
  - End Date
end note

:Click export button;

|System|
:Validate JWT token;
:Check super_admin role;

if (Authorized?) then (yes)
    :Build SQL query with filters;
    :Execute query;
    :Fetch filtered tickets;

    if (Format = Excel?) then (yes)
        :Initialize ExcelJS Workbook;
        :Create worksheet;
        :Add styled headers;
        note right
          Headers:
          - No
          - Kode Tiket
          - Judul
          - Deskripsi
          - Kategori
          - Status
          - Divisi User
          - Divisi Tujuan
          - Dibuat
          - Diperbarui
        end note

        :Add data rows with status colors;
        :Add summary statistics;
        :Generate .xlsx buffer;
        :Set Content-Disposition header;
        :Return Excel file;

    else (PDF)
        :Initialize PDFKit document;
        :Set landscape A4 format;
        :Add header with title;
        :Add filter info;
        :Create table structure;

        while (More tickets?) is (yes)
            :Add ticket row;
            if (Page full?) then (yes)
                :Add new page;
                :Repeat headers;
            endif
        endwhile (no)

        :Add page numbers;
        :Add summary statistics;
        :Generate PDF buffer;
        :Return PDF file;
    endif

    |Super Admin|
    :Download file;
    :Display success message;

else (no)
    |Super Admin|
    :Display "Unauthorized" error;
endif

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - NOTIFICATION FLOW
' ============================================================

@startuml Activity_NotificationFlow
!theme plain
title Activity Diagram - Notification System Flow

|System|
start

:Event occurs;
note right
  Events:
  - New ticket created
  - Ticket status updated
  - Admin notes added
  - Admin image uploaded
  - Comment added
end note

switch (Event type?)
case (new_ticket)
    fork
        :Get admins from user_division;
    fork again
        :Get admins from target_divisions;
    fork again
        :Get all super_admins;
    fork again
        :Get users in target_divisions;
    end fork
case (status_update)
    :Get ticket creator;
case (admin_action)
    :Get ticket creator;
case (comment)
    if (Commenter is admin?) then (yes)
        :Get ticket creator;
    else (no)
        :Get relevant admins;
    endif
endswitch

:Build notification message;

fork
    :Insert into notifications table;
fork again
    :Insert into user_notifications table;
fork again
    :Insert into super_admin_notifications table;
end fork

|Client|
:Poll every 30 seconds;
:GET /api/user/notifications;
:GET /api/admin/notifications;
:Update unread count badge;
:Display notification panel;

stop

@enduml


' ============================================================
' ACTIVITY DIAGRAM - USER MANAGEMENT
' ============================================================

@startuml Activity_UserManagement
!theme plain
title Activity Diagram - User Management (Super Admin)

|Super Admin|
start
:Open User Management Panel;

split
    :View Users;
    :GET /api/super-admin/users;
    :Display user list with roles;
split again
    :Create User;
    :Fill user form;
    :Submit POST /api/super-admin/users;

    |System|
    if (Email unique?) then (yes)
        :Hash password;
        :Create user record;
        :Return success;
    else (no)
        :Return "Email exists" error;
    endif

split again
    :Update User;
    :Select user;
    :Modify user details;
    :Submit PATCH /api/super-admin/users;

    |System|
    :Validate changes;
    :Update user record;
    :Return success;

split again
    :Deactivate User;
    :Select user;
    :Confirm deactivation;
    :Submit DELETE /api/super-admin/users;

    |System|
    :Set is_active = false;
    note right
      Soft delete:
      User record preserved
      but cannot login
    end note
    :Return success;

end split

|Super Admin|
:Refresh user list;
:Display result message;

stop

@enduml


' ============================================================
' SEQUENCE DIAGRAM - LOGIN
' ============================================================

@startuml Sequence_Login
!theme plain
title Sequence Diagram - Login Process

actor User
participant "Login Page" as LP
participant "Auth API\n/api/auth/login" as API
database "MySQL\nDatabase" as DB

User -> LP: Enter email & password
User -> LP: Click Login

LP -> API: POST /api/auth/login\n{email, password}

API -> DB: SELECT * FROM users\nWHERE email = ?
DB --> API: User record (or null)

alt User not found
    API --> LP: 401 Unauthorized\n{error: "Email tidak ditemukan"}
    LP --> User: Display error message
else User found
    API -> API: bcrypt.compare(password, hash)

    alt Password invalid
        API --> LP: 401 Unauthorized\n{error: "Password salah"}
        LP --> User: Display error message
    else Password valid
        alt User inactive
            API --> LP: 401 Unauthorized\n{error: "Akun dinonaktifkan"}
            LP --> User: Display error message
        else User active
            API -> API: Generate JWT token\n{userId, role}
            API -> DB: UPDATE users\nSET last_login = NOW()
            API --> LP: 200 OK\n{token, user, message}
            LP -> LP: Store token in localStorage
            LP --> User: Redirect to dashboard\n(based on role)
        end
    end
end

@enduml


' ============================================================
' SEQUENCE DIAGRAM - CREATE TICKET
' ============================================================

@startuml Sequence_CreateTicket
!theme plain
title Sequence Diagram - Create Ticket with NLP Classification

actor User
participant "Ticket Form" as TF
participant "Tickets API\n/api/tickets" as API
participant "NLP API\n/api/nlp/classify" as NLP
participant "Flask NLP\nService" as Flask
participant "Routing\nService" as RS
database "MySQL\nDatabase" as DB

User -> TF: Fill ticket details\n(title, description, image)
User -> TF: Submit ticket

TF -> API: POST /api/tickets\n{title, description, category, image}

API -> API: Validate JWT token
API -> DB: Get user info\n(division, name)

API -> NLP: POST /api/nlp/classify\n{text: title + description}
NLP -> Flask: POST /classify\n{text}
Flask -> Flask: TF-IDF vectorization
Flask -> Flask: Model prediction
Flask -> Flask: Extract keywords
Flask --> NLP: {category, confidence, keywords}
NLP --> API: NLP classification result

API -> RS: getTargetDivisionsByCategory(nlp_category)
RS -> DB: SELECT * FROM category_division_mapping\nWHERE nlp_category = ?
DB --> RS: Target divisions
RS --> API: target_divisions[]

API -> DB: INSERT INTO tickets\n(all fields including NLP data)
DB --> API: ticket_id

API -> RS: createTicketNotifications(ticket)
RS -> DB: Get admins from user_division
RS -> DB: Get admins from target_divisions
RS -> DB: Get all super_admins
RS -> DB: Get users in target_divisions

loop For each recipient
    RS -> DB: INSERT INTO notifications\n(admin notifications)
    RS -> DB: INSERT INTO user_notifications\n(user notifications)
    RS -> DB: INSERT INTO super_admin_notifications
end

RS --> API: Notifications created

API --> TF: 201 Created\n{ticket, routing_info}
TF --> User: Display success\nShow ticket code (e.g., IT-001)

@enduml


' ============================================================
' SEQUENCE DIAGRAM - UPDATE TICKET STATUS
' ============================================================

@startuml Sequence_UpdateStatus
!theme plain
title Sequence Diagram - Update Ticket Status

actor Admin
participant "Ticket Detail\nModal" as TD
participant "Tickets API\n/api/tickets/[id]" as API
database "MySQL\nDatabase" as DB

Admin -> TD: Select new status
Admin -> TD: Click Update

TD -> API: PATCH /api/tickets/{id}\n{status: "in_progress"}

API -> API: Validate JWT token
API -> API: Check role (admin/super_admin)

API -> DB: SELECT * FROM tickets\nWHERE id = ?
DB --> API: Ticket record

alt Status is 'closed'
    API -> API: Check if admin is ticket creator
    alt Not the creator
        API --> TD: 403 Forbidden\n{error: "Hanya pembuat tiket"}
        TD --> Admin: Display error
    end
end

API -> DB: UPDATE tickets\nSET status = ?, updated_at = NOW()
DB --> API: Success

API -> DB: INSERT INTO ticket_comments\n(comment_type: 'status_change')
DB --> API: Comment created

API -> DB: SELECT id_user FROM tickets
API -> DB: INSERT INTO user_notifications\n{type: 'status_update', message}
DB --> API: Notification created

API --> TD: 200 OK\n{ticket: updated}
TD -> TD: Refresh ticket data
TD --> Admin: Display success message

@enduml


' ============================================================
' SEQUENCE DIAGRAM - NLP CLASSIFICATION
' ============================================================

@startuml Sequence_NLPClassification
!theme plain
title Sequence Diagram - NLP Text Classification

participant "Client" as C
participant "NLP API\n/api/nlp/classify" as API
participant "Flask NLP\nService" as Flask
participant "Model\n(model.pkl)" as Model
participant "Vectorizer\n(vectorizer.pkl)" as Vec

C -> API: POST /api/nlp/classify\n{text: "Wifi kantor tidak bisa connect"}

API -> Flask: POST http://localhost:8000/classify\n{text}

Flask -> Flask: Preprocess text\n(lowercase, clean)

Flask -> Vec: Transform text to vector
Vec -> Vec: TF-IDF transformation
Vec --> Flask: Feature vector

Flask -> Model: Predict category
Model -> Model: Classification
Model --> Flask: Predicted category

Flask -> Flask: Calculate confidence score
Flask -> Flask: Extract matched keywords

Flask --> API: {\n  "category": "IT",\n  "confidence": 92.5,\n  "matched_keywords": ["wifi", "connect"]\n}

API --> C: {\n  "category": "IT",\n  "confidence": 92.5,\n  "keywords": ["wifi", "connect"]\n}

@enduml


