    --
    *ticket_id : INT <<FK>>
    *user_id : INT <<FK>>
    *comment : TEXT
    comment_type : ENUM('comment','status_change','response')
    old_status : VARCHAR(50)
    new_status : VARCHAR(50)
    attachment_path : VARCHAR(500)
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

entity "category_division_mapping" as category_mapping {
    *id : INT <<PK>>
    --
    *nlp_category : VARCHAR(100)
    *target_division : VARCHAR(100)
    is_active : BOOLEAN
    priority : INT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
}

