    package "User Management" {
        usecase "UC27: View All Users" as UC27
        usecase "UC28: Create User" as UC28
        usecase "UC29: Update User" as UC29
        usecase "UC30: Deactivate User" as UC30
    }

    package "Category & Division Mapping" {
        usecase "UC31: View Category Mappings" as UC31
        usecase "UC32: Create Category Mapping" as UC32
        usecase "UC33: Update Category Mapping" as UC33
    }

    package "Dashboard & Reports" {
        usecase "UC34: View Statistics" as UC34
        usecase "UC35: View Division Stats" as UC35
        usecase "UC36: Generate NLP Analysis" as UC36
    }

    package "NLP Classification" {
        usecase "UC37: Classify Ticket Text" as UC37
        usecase "UC38: Route to Division" as UC38
    }
}

