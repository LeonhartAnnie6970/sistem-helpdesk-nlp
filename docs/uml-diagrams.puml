@startuml UseCase_Diagram
!theme plain
title Use Case Diagram - Sistem Helpdesk NLP SJPL

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' ========== ACTORS ==========
actor "User" as user
actor "Admin" as admin
actor "Super Admin" as superadmin
actor "NLP System" as nlp <<system>>

admin -|> user : extends
superadmin -|> admin : extends

' ========== PACKAGES ==========

rectangle "Sistem Helpdesk NLP SJPL" {

    package "Authentication" {
        usecase "UC01: Login" as UC01
        usecase "UC02: Register" as UC02
        usecase "UC03: Logout" as UC03
        usecase "UC04: Change Password" as UC04
    }

    package "Profile Management" {
        usecase "UC05: View Profile" as UC05
        usecase "UC06: Update Profile Image" as UC06
    }

    package "Ticket Management - User" {
        usecase "UC07: Create Ticket" as UC07
        usecase "UC08: View Own Tickets" as UC08
        usecase "UC09: View Incoming Tickets" as UC09
        usecase "UC10: View Ticket Detail" as UC10
        usecase "UC11: Add Comment" as UC11
        usecase "UC12: Close Own Ticket" as UC12
        usecase "UC13: Upload Ticket Image" as UC13
    }

    package "Ticket Management - Admin" {
        usecase "UC14: View Division Tickets" as UC14
        usecase "UC15: Update Ticket Status" as UC15
        usecase "UC16: Add Admin Notes" as UC16
        usecase "UC17: Upload Admin Image" as UC17
        usecase "UC18: Override NLP Category" as UC18
        usecase "UC19: Search Tickets" as UC19
    }

    package "Ticket Management - Super Admin" {
        usecase "UC20: View All Tickets" as UC20
        usecase "UC21: Delete Ticket" as UC21
        usecase "UC22: Export to Excel" as UC22
        usecase "UC23: Export to PDF" as UC23
    }

    package "Notification System" {
        usecase "UC24: View Notifications" as UC24
        usecase "UC25: Mark Notification Read" as UC25
        usecase "UC26: Mark All Read" as UC26
