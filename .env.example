# JWT
JWT_SECRET=your_long_random_secret_here_change_in_production

# Database MySQL - gunakan instance LOKAL Anda sendiri di sini, jangan pernah
# arahkan ke database production (TiDB Cloud dsb). Production dikonfigurasi
# terpisah lewat environment variables di dashboard Vercel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistem_helpdesk_nlp

# Upload Driver: "local" (simpan ke public/uploads, aman untuk dev) atau
# "blob" (Vercel Blob, dipakai otomatis di production). Selalu pakai "local"
# di .env.local Anda supaya file yang Anda test tidak pernah nyasar ke
# storage production.
UPLOAD_DRIVER=local

# Vercel Blob - JANGAN diisi dengan token production di .env.local Anda.
# Hanya isi ini kalau memang sengaja mau menguji jalur upload ke Blob dari
# lokal, dan gunakan Blob store terpisah khusus dev (bukan yang dipakai
# production).
# BLOB_PROFILE_STORE_ID=
# BLOB_PROFILE_READ_WRITE_TOKEN=

# NLP API
NLP_API_URL=http://127.0.0.1:8000
